# Copy to backend/.env and fill in. All values below are REQUIRED unless marked optional.
# The app refuses to start if a required value is missing or too short.

# Supabase SESSION pooler URL (port 5432). Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CODE_PEPPER=

# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:3000

# Optional: development | production   (default: production — fail closed)
APP_ENV=development

# Tests only: a LOCAL database whose name ends in _test. Tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://outing_test:PASSWORD@localhost:5432/outing_test

# Only these email domains can register or be invited as contacts (comma-separated).
ALLOWED_EMAIL_DOMAINS=geu.ac.in

# Email delivery. "console" prints codes to the log and is refused when APP_ENV=production.
EMAIL_BACKEND=console
# For EMAIL_BACKEND=smtp (any provider: Resend, Brevo, Google Workspace, SES, ...):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                       # 587 = STARTTLS, 465 = TLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Outing <no-reply@your-domain>
