# Copy to backend/.env and fill in. All values below are REQUIRED unless marked optional.
# The app refuses to start if a required value is missing or too short.

# Supabase SESSION pooler URL (port 5432). Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CODE_PEPPER=

# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:3000

# Optional: development | production   (default: production — fail closed)
APP_ENV=development

# Tests only: a LOCAL database whose name ends in _test. Tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://outing_test:PASSWORD@localhost:5432/outing_test

# Only these email domains can register or be invited as contacts (comma-separated).
ALLOWED_EMAIL_DOMAINS=geu.ac.in
# Optional: specific outside addresses for testing (comma-separated). Each also allows its
# plus aliases, e.g. listing you@gmail.com allows you+test1@gmail.com and you+test2@gmail.com.
# ALLOWED_TEST_EMAILS=you@gmail.com

# Email delivery. "console" prints codes to the log and is refused when APP_ENV=production.
# "resend" sends over HTTPS (use it where SMTP ports are blocked, e.g. Render's free plan):
# EMAIL_BACKEND=resend
# RESEND_API_KEY=
# EMAIL_FROM=Lumiback <no-reply@your-domain>
EMAIL_BACKEND=console
# For EMAIL_BACKEND=smtp (any provider: Resend, Brevo, Google Workspace, SES, ...):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                       # 587 = STARTTLS, 465 = TLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Lumiback <no-reply@your-domain>

# Optional, for deployment behind proxies (see README "Deploying"):
# INTERNAL_API_SECRET=              # shared with the web app; lets it forward the visitor's IP
# PROXY_HOPS=1                      # proxies in front that append to X-Forwarded-For (Render: 1)

# Optional: the public web address. Gate QR codes point at {WEB_URL}/g/..., so someone who scans
# with a plain camera app lands on a page telling them to use Lumiback.
# WEB_URL=https://lumiback.abhinesh.codes

# Push notifications to the mobile app. "log" (default) only logs them; "expo" sends through
# Expo's push service. EXPO_ACCESS_TOKEN is needed only if enhanced push security is enabled.
# PUSH_BACKEND=expo
# EXPO_ACCESS_TOKEN=
