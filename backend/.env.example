# Copy to backend/.env and fill in. All values below are REQUIRED unless marked optional.
# The app refuses to start if a required value is missing or too short.

# Supabase SESSION pooler URL (port 5432). Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CODE_PEPPER=

# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:3000

# Optional: development | production   (default: production — fail closed)
APP_ENV=development
