# Server-only. Base URL of the FastAPI backend (never exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Optional, for deployment (see the root README, "Deploying"). Leave unset in development.
# INTERNAL_API_SECRET=                # same value as the API's
# CLIENT_IP_HEADER=cf-connecting-ip   # header your edge sets with the visitor's IP
# EDGE_SECRET=                        # the edge also sends this as X-Edge-Auth; required with the above
