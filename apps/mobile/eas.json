{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-universal-release.apk"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/apk/release/app-armeabi*-release.apk",
        "android/app/build/outputs/apk/release/app-arm64*-release.apk"
      ],
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "environment": "production",
      "channel": "production"
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-universal-release.apk"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/apk/release/app-armeabi*-release.apk",
        "android/app/build/outputs/apk/release/app-arm64*-release.apk"
      ]
    }
  },
  "submit": {
    "production": {}
  }
}
