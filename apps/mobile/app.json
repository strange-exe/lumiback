{
  "expo": {
    "name": "Lumiback",
    "slug": "lumiback",
    "scheme": "lumiback",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fafafb",
    "android": {
      "package": "codes.abhinesh.lumiback",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#fafafb",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#08090c"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lumiback uses your location only while you choose to share it with people you approve.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1f3fd1"
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumiback uses the camera to scan the QR code at the campus gate.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8196cc1-95f6-4017-b4b0-41d506d4be76"
      }
    },
    "owner": "strange-exe",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a8196cc1-95f6-4017-b4b0-41d506d4be76"
    }
  }
}
